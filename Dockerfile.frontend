### Multi-stage Dockerfile for frontend (Vite) — build then serve with nginx
FROM node:22-alpine AS builder
WORKDIR /app

# Install dependencies (.npmrc carries legacy-peer-deps for React 19 + framer-motion)
COPY package*.json .npmrc ./
RUN npm ci --no-audit --no-fund

# Copy sources and build. VITE_* values are public (anon key / URL); pass them as build args.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_ORG_SLUG=kashiful-hudha
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_ORG_SLUG=$VITE_ORG_SLUG
COPY . .
RUN npm run build

### Production image
FROM nginx:stable-alpine
COPY --from=builder /app/dist /usr/share/nginx/html

# SPA-friendly config
COPY docker/frontend-nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost/ >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
