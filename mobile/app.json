{
  "expo": {
    "name": "Kashiful Hudha",
    "slug": "kashiful-hudha",
    "scheme": "kashifulhudha",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#047857"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Kashiful Hudha to use Face ID to unlock the app."
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "package": "lk.kashifulhudha.portal",
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "lk.kashifulhudha.portal",
      "supportsTablet": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "54fa0646-4f69-4a3f-8a94-b979040b7ffe"
      }
    }
  }
}
