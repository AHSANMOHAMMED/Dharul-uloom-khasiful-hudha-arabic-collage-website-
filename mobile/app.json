{
  "expo": {
    "name": "Kashiful Hudha",
    "slug": "kashiful-hudha",
    "scheme": "kashifulhudha",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "plugins": ["expo-router", "expo-secure-store"],
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "kashifulhudha", "pathPrefix": "/payment" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "associatedDomains": ["applinks:kashifulhudha.lk"]
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
