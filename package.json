{
  "name": "dharul-uloom-kashiful-hudha-website",
  "version": "1.0.0",
  "description": "Official website for Dharul Uloom Kashiful Hudha Arabic College",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:frontend": "vite",
    "dev:backend:legacy": "cd backend && LEGACY_API_ENABLED=1 npm run dev",
    "dev:legacy": "echo 'DEPRECATED: Mongoose API is archived. Use npm run dev (Supabase). Opt-in only: npm run dev:backend:legacy' && exit 1",
    "build": "vite build",
    "build:backend": "echo 'No backend build — production uses Supabase, not Express/Mongo.' && exit 0",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "import:shamela": "node scripts/shamela/importShamela.mjs",
    "import:shamela:archive": "node scripts/shamela/importShamelaArchive.mjs",
    "upload:book": "node scripts/shamela/manualUpload.mjs",
    "db:apply": "node scripts/applyMigrations.mjs",
    "db:apply:all": "node scripts/applyMigrations.mjs --from=0001",
    "db:seed:library": "node scripts/applyMigrations.mjs --from=0011",
    "setup:admin": "node scripts/setupAdmin.mjs",
    "setup:portal-users": "node scripts/setupPortalUsers.mjs",
    "setup:production-demo": "node scripts/seedProductionReady.mjs",
    "setup:api-verify": "node scripts/seedAndVerifyApis.mjs",
    "setup:auth-urls": "node scripts/configureAuthRedirects.mjs",
    "deploy:functions": "node scripts/deployEdgeFunctions.mjs",
    "setup:service-role": "node scripts/setServiceRoleKey.mjs",
    "install:all": "npm install && cd backend && npm install",
    "test:db": "bash scripts/testDatabase.sh",
    "test:perf": "bash scripts/perf/run.sh --concurrency 50 --requests 3000"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "axios": "^1.6.2",
    "docx": "^9.5.1",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "framer-motion": "^10.16.16",
    "i18next": "^23.7.6",
    "mammoth": "^1.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.66.0",
    "react-i18next": "^13.5.0",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^11.0.5",
    "recharts": "^3.3.0",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^24.1.3",
    "p-limit": "^7.3.0",
    "pg": "^8.21.0",
    "postcss": "^8.4.32",
    "shamela": "^1.3.4",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8",
    "vitest": "^1.0.4",
    "ws": "^8.22.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
